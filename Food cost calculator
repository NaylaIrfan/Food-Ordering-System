#include <iostream>
using namespace std;

int main() {
    int choice, quantity;
    double total = 0;

    cout << "===== FOOD ORDERING SYSTEM =====" << endl;
    cout << "1. Pizza    - Rs. 200" << endl;
    cout << "2. Burger   - Rs. 100" << endl;
    cout << "3. Sandwich - Rs. 80" << endl;
    cout << "4. Pasta    - Rs. 150" << endl;
    cout << "5. Exit" << endl;

    cout << "\nEnter your choice: ";
    cin >> choice;

    if (choice == 5) {
        cout << "Thank you! Visit again." << endl;
    }
    else if (choice >= 1 && choice <= 4) {
        cout << "Enter quantity: ";
        cin >> quantity;

        if (choice == 1) {
            total = 200 * quantity;
            cout << "You ordered Pizza." << endl;
        }
        else if (choice == 2) {
            total = 100 * quantity;
            cout << "You ordered Burger." << endl;
        }
        else if (choice == 3) {
            total = 80 * quantity;
            cout << "You ordered Sandwich." << endl;
        }
        else if (choice == 4) {
            total = 150 * quantity;
            cout << "You ordered Pasta." << endl;
        }

        cout << "Total Cost = Rs. " << total << endl;
        cout << "Thank you for your order!" << endl;
    }
    else {
        cout << "Invalid choice!" << endl;
    }

    return 0;
}
